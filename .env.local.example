# Admin password for the certificate generator
ADMIN_PASSWORD=your_secure_password_here

# Secret used to sign admin sessions (at least 32 random characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs every admin out.
AUTH_SECRET=replace_with_64_random_hex_characters

# Vercel Blob token for template uploads (added automatically when you
# connect a Blob store to the Vercel project).
BLOB_READ_WRITE_TOKEN=
